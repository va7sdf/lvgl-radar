#!/bin/bash
# demo-mode on|off|status
#   on   the radar starts with demo.conf and the replay of ./recording,
#        now and at every boot, with no network needed
#   off  back to radar.conf and your live receiver
set -e
DIR=$(cd "$(dirname "$0")/.." && pwd)
USER_NAME=$(stat -c %U "$DIR")
DROPIN=/etc/systemd/system/radar.service.d/demo.conf
REPLAY=/etc/systemd/system/radar-replay.service

case "$1" in
on)
    [ -f "$DIR/recording/frames.jsonl.gz" ] || { echo "No recording yet: run demo/demo.py record first"; exit 1; }
    [ -f "$DIR/demo.conf" ] || sudo -u "$USER_NAME" python3 "$DIR/demo/demo.py" conf
    sudo tee "$REPLAY" >/dev/null <<EOF
[Unit]
Description=Replay of recorded radar data for demos
After=local-fs.target

[Service]
User=$USER_NAME
ExecStart=/usr/bin/python3 $DIR/demo/demo.py replay --rec $DIR/recording
Restart=always

[Install]
WantedBy=multi-user.target
EOF
    sudo mkdir -p "$(dirname "$DROPIN")"
    sudo tee "$DROPIN" >/dev/null <<EOF
# Added by demo/demo-mode; remove with: demo/demo-mode off
[Unit]
Wants=radar-replay.service
After=radar-replay.service

[Service]
ExecStart=
ExecStart=$DIR/build/radar demo.conf
EOF
    sudo systemctl daemon-reload
    sudo systemctl enable --now radar-replay.service
    sudo systemctl restart radar.service
    echo "Demo mode on: replaying $DIR/recording"
    ;;
off)
    sudo rm -f "$DROPIN"
    sudo systemctl disable --now radar-replay.service 2>/dev/null || true
    sudo rm -f "$REPLAY"
    sudo systemctl daemon-reload
    sudo systemctl restart radar.service
    echo "Demo mode off: live data from radar.conf"
    ;;
status)
    if [ -f "$DROPIN" ]; then echo "Demo mode is on"; else echo "Demo mode is off"; fi
    ;;
*)
    echo "usage: $0 on|off|status"; exit 2
    ;;
esac
